  );
}


// ============================================================
// MECHANICAL ROLL
//
// INCREASE:
// old digit goes UP
// new digit enters from BOTTOM
//
// DECREASE:
// old digit goes DOWN
// new digit enters from TOP
//
// IMPORTANT:
//
// ease8InOutQuad makes the movement much more visible
// and mechanical on an 8-pixel-high display.
// ============================================================

void drawRollingDigit(
  uint8_t slot,
  uint8_t slots,
  uint8_t oldDigit,
  uint8_t newDigit,
  uint8_t progress,
  int8_t direction
) {

  int digitX =
    getDigitX(
      slot,
      slots
    );


  int panelX =
    getPanelX(
      slot,
      slots
    );


  int panelWidth =
    getPanelWidth(
      slots
    );


  uint8_t scaleX =
    getDigitScaleX(
      slots
    );


  // Smooth mechanical easing
  uint8_t eased =
    ease8InOutQuad(
      progress
    );


  int movement =
    (
      (uint16_t)eased *
      6
    ) / 255;


  int oldY;
  int newY;


  // Increasing followers
  if (direction >= 0) {

    oldY =
      DIGIT_Y -
      movement;


    newY =
      DIGIT_Y +
      6 -
      movement;
  }


  // Decreasing followers
  else {

    oldY =
      DIGIT_Y +
      movement;


    newY =
      DIGIT_Y -
      6 +
      movement;
  }


  // ==========================================================
  // OLD DIGIT
  // white -> pink while leaving
  // ==========================================================

  CRGB oldColor =
    blend(
      CRGB(250, 245, 255),
      CRGB(255, 90, 150),
      progress
    );


  drawDigitAt(
    oldDigit,
    digitX,
    oldY,
    oldColor,
    scaleX
  );


  // ==========================================================
  // NEW DIGIT
  // pink -> white while arriving
  // ==========================================================

  CRGB newColor =
    blend(
      CRGB(255, 90, 145),
      CRGB(250, 245, 255),
      progress
    );


  drawDigitAt(
    newDigit,
    digitX,
    newY,
    newColor,
    scaleX
  );


  // ==========================================================
  // HINGE FLASH
  // ==========================================================

  int distance =
    abs(
      (int)progress -
      128
    );


  if (
    distance < 24
  ) {

    uint8_t strength =
      255 -
      distance * 10;


    CRGB flash =
      CRGB(
        strength,
        strength / 3,
        strength / 2
      );


    for (
      int xx = 0;
      xx < panelWidth;
      xx++
    ) {

      pixel(
        panelX + xx,
        3,
        flash
      );
    }
  }
}


// ============================================================
// FIND RIGHTMOST CHANGED DIGIT
// ============================================================

int findRightmostChangedDigit() {

  for (
    int i =
      currentSlotCount - 1;

    i >= 0;

    i--
  ) {

    if (
      currentDigits[i] !=
      targetDigits[i]
    ) {

      return i;
    }
  }


  return -1;
}


// ============================================================
// FIND NEXT CHANGED DIGIT TO LEFT
// ============================================================

int findNextChangedDigitToLeft(
  int currentSlot
) {

  for (
    int i =
      currentSlot - 1;

    i >= 0;

    i--
  ) {

    if (
      currentDigits[i] !=
      targetDigits[i]
    ) {

      return i;
    }
  }


  return -1;
}


// ============================================================
// START NORMAL NUMBER TRANSITION
// ============================================================

void startTransitionTo(
  uint32_t newCount,
  uint32_t now
) {

  transitionTargetCount =
    newCount;


  if (
    newCount >=
    followerCount
  ) {

    rollDirection =
      1;

  } else {

    rollDirection =
      -1;
  }


  numberToDigits(
    newCount,
    currentSlotCount,
    targetDigits
  );


  activeDigit =
    findRightmostChangedDigit();


  if (
    activeDigit >= 0
  ) {

    flipping =
      true;


    // IMPORTANT:
    // fresh timestamp
    flipStart =
      now;


    Serial.print(
      "Starting flip: "
    );


    Serial.print(
      followerCount
    );


    Serial.print(
      " -> "
    );


    Serial.println(
      newCount
    );
  }
}


// ============================================================
// FINISH CURRENT DIGIT
//
// Carry works right -> left.
//
// Example:
//
// 2309 -> 2310
//
// 9 -> 0 first
// 0 -> 1 second
// ============================================================

void finishCurrentDigit(
  uint32_t now
) {

  if (
    activeDigit < 0
  ) {

    return;
  }


  currentDigits[activeDigit] =
    targetDigits[activeDigit];


  int nextDigit =
    findNextChangedDigitToLeft(
      activeDigit
    );


  if (
    nextDigit >= 0
  ) {

    activeDigit =
      nextDigit;


    flipStart =
      now;


    return;
  }


  // Entire count step completed
  followerCount =
    transitionTargetCount;


  flipping =
    false;


  activeDigit =
    -1;


  nextAnimationStep =
    now +
    CATCHUP_PAUSE;


  Serial.print(
    "Display now: "
  );


  Serial.println(
    followerCount
  );
}


// ============================================================
// START PANEL-LAYOUT CHANGE
//
// Example:
//
// 99 -> 100
//
// 2 panels -> 4 panels
//
// 9999 -> 10000
//
// 4 panels -> 6 panels
// ============================================================

void startLayoutFlip(
  uint32_t newCount,
  uint32_t now
) {

  layoutTargetCount =
    newCount;


  layoutTargetSlots =
    getSlotCount(
      newCount
    );


  layoutFlipping =
    true;


  layoutFlipStart =
    now;
}


// ============================================================
// FINISH PANEL-LAYOUT CHANGE
// ============================================================

void finishLayoutFlip(
  uint32_t now
) {

  currentSlotCount =
    layoutTargetSlots;


  followerCount =
    layoutTargetCount;


  transitionTargetCount =
    followerCount;


  numberToDigits(
    followerCount,
    currentSlotCount,
    currentDigits
  );


  numberToDigits(
    followerCount,
    currentSlotCount,
    targetDigits
  );


  layoutFlipping =
    false;


  nextAnimationStep =
    now +
    CATCHUP_PAUSE;
}


// ============================================================
// POWER-ON FULL FLIP
//
// No random data.
//
// Deterministic 0-9 cycling just for visual animation.
// ============================================================

void drawFullFlipAnimation(
  uint8_t slots,
  uint32_t elapsed
) {

  uint32_t cycle =
    elapsed /
    STARTUP_CYCLE_TIME;


  uint32_t cyclePosition =
    elapsed %
    STARTUP_CYCLE_TIME;


  uint8_t progress =
    (
      cyclePosition *
      255UL
    ) /
    STARTUP_CYCLE_TIME;


  for (
    uint8_t i = 0;
    i < slots;
    i++
  ) {

    uint8_t oldDigit =
      (
        cycle +
        i * 2
      ) %
      10;


    uint8_t newDigit =
      (
        oldDigit +
        1
      ) %
      10;


    drawRollingDigit(
      i,
      slots,
      oldDigit,
      newDigit,
      progress,
      1
    );
  }
}


// ============================================================
// UPDATE PHYSICAL DISPLAY TOWARD LIVE INSTAGRAM COUNT
// ============================================================

void updateLiveCounter(
  uint32_t now
) {

  if (
    !haveLiveCount ||
    startupFlipping ||
    layoutFlipping ||
    flipping
  ) {

    return;
  }


  if (
    (int32_t)(
      now -
      nextAnimationStep
    ) < 0
  ) {

    return;
  }


  // Already synchronized
  if (
    followerCount ==
    liveFollowerCount
  ) {

    return;
  }


  uint32_t difference;


  if (
    liveFollowerCount >
    followerCount
  ) {

    difference =
      liveFollowerCount -
      followerCount;

  } else {

    difference =
      followerCount -
      liveFollowerCount;
  }


  uint32_t nextCount;


  // ==========================================================
  // SMALL DIFFERENCE:
  // mechanically count every follower
  // ==========================================================

  if (
    difference <=
    MAX_CATCHUP
  ) {

    if (
      liveFollowerCount >
      followerCount
    ) {

      nextCount =
        followerCount + 1;

    } else {

      nextCount =
        followerCount - 1;
    }
  }


  // ==========================================================
  // LARGE DIFFERENCE:
  // directly target latest value,
  // but still animate changed digit wheels
  // ==========================================================

  else {

    nextCount =
      liveFollowerCount;
  }


  uint8_t newSlots =
    getSlotCount(
      nextCount
    );


  // Layout length changed
  if (
    newSlots !=
    currentSlotCount
  ) {

    startLayoutFlip(
      nextCount,
      now
    );


    return;
  }


  // Normal mechanical update
  startTransitionTo(
    nextCount,
    now
  );
}


// ============================================================
// JSON FOLLOWERS_COUNT PARSER
//
// Reads:
//
// "followers_count":2305
//
// No ArduinoJson library required.
// ============================================================

bool parseFollowersCount(
  const String& json,
  uint32_t& result
) {

  const String key =
    "\"followers_count\"";


  int keyPosition =
    json.indexOf(
      key
    );


  if (
    keyPosition < 0
  ) {

    return false;
  }


  int colonPosition =
    json.indexOf(
      ':',
      keyPosition
    );


  if (
    colonPosition < 0
  ) {

    return false;
  }


  int position =
    colonPosition + 1;


  // Skip whitespace
  while (
    position <
    json.length()
  ) {

    char c =
      json[position];


    if (
      c != ' ' &&
      c != '\t' &&
      c != '\r' &&
      c != '\n'
    ) {

      break;
    }


    position++;
  }


  uint32_t value =
    0;


  bool foundDigit =
    false;


  while (
    position <
    json.length()
  ) {

    char c =
      json[position];


    if (
      c < '0' ||
      c > '9'
    ) {

      break;
    }


    foundDigit =
      true;


    value =
      value * 10 +
      (c - '0');


    position++;
  }


  if (
    !foundDigit
  ) {

    return false;
  }


  result =
    value;


  return true;
}


// ============================================================
// PAUSE ANIMATION CLOCKS WHILE HTTPS IS BLOCKING
//
// THIS FIXES THE IMPORTANT BUG.
//
// HTTPS may take 500ms+.
//
// Without this:
// FLIP_TIME = 480ms
//
// HTTP request can consume the entire animation time,
// making:
//
// 7 -> 8
//
// appear instant.
//
// This function shifts animation clocks forward by however
// long the HTTP request took.
// ============================================================

void compensateForNetworkDelay(
  uint32_t networkDuration
) {

  if (
    networkDuration == 0
  ) {

    return;
  }


  if (flipping) {

    flipStart +=
      networkDuration;
  }


  if (startupFlipping) {

    startupFlipStart +=
      networkDuration;
  }


  if (layoutFlipping) {

    layoutFlipStart +=
      networkDuration;
  }


  if (
    nextAnimationStep != 0
  ) {

    nextAnimationStep +=
      networkDuration;
  }
}


// ============================================================
// FETCH LIVE INSTAGRAM FOLLOWERS
// ============================================================

bool fetchInstagramFollowers(
  uint32_t& followers
) {

  if (
    WiFi.status() !=
    WL_CONNECTED
  ) {

    Serial.println(
      "Instagram request skipped: WiFi disconnected."
    );


    return false;
  }


  WiFiClientSecure client;


  // Simple testing configuration.
  //
  // For final production hardware,
  // replace this with CA certificate validation.
  client.setInsecure();


  HTTPClient http;


  String url =
    "https://graph.instagram.com/me"
    "?fields=followers_count"
    "&access_token=";


  url +=
    INSTAGRAM_ACCESS_TOKEN;


  http.setTimeout(
    HTTP_TIMEOUT
  );


  // Ask intermediary caches not to reuse an old result.
  http.addHeader(
    "Cache-Control",
    "no-cache"
  );


  Serial.println();
  Serial.println(
    "--------------------------------"
  );

  Serial.println(
    "Checking LIVE Instagram followers..."
  );


  if (
    !http.begin(
      client,
      url
    )
  ) {

    Serial.println(
      "HTTP begin failed."
    );


    return false;
  }


  int httpCode =
    http.GET();


  Serial.print(
    "HTTP status: "
  );


  Serial.println(
    httpCode
  );


  if (
    httpCode !=
    HTTP_CODE_OK
  ) {

    String errorPayload =
      http.getString();


    Serial.println(
      "Instagram API error:"
    );


    Serial.println(
      errorPayload
    );


    http.end();


    return false;
  }


  String payload =
    http.getString();


  http.end();


  uint32_t count =
    0;


  if (
    !parseFollowersCount(
      payload,
      count
    )
  ) {

    Serial.println(
      "ERROR: followers_count not found."
    );


    Serial.println(
      payload
    );


    return false;
  }


  followers =
    count;


  Serial.print(
    "Instagram followers = "
  );


  Serial.println(
    followers
  );


  return true;
}


// ============================================================
// PROCESS SUCCESSFUL INSTAGRAM RESULT
// ============================================================

void processInstagramResult(
  uint32_t apiCount,
  uint32_t now
) {

  // Current physical design supports 6 digits
  if (
    apiCount >
    999999
  ) {

    apiCount =
      999999;
  }


  // ==========================================================
  // FIRST SUCCESSFUL API RESPONSE
  // ==========================================================

  if (
    !haveLiveCount
  ) {

    haveLiveCount =
      true;


    liveFollowerCount =
      apiCount;


    followerCount =
      apiCount;


    transitionTargetCount =
      apiCount;


    currentSlotCount =
      getSlotCount(
        apiCount
      );


    numberToDigits(
      followerCount,
      currentSlotCount,
      currentDigits
    );


    numberToDigits(
      followerCount,
      currentSlotCount,
      targetDigits
    );


    // Start the requested 2-second full flip
    startupFlipping =
      true;


    startupFlipStart =
      now;


    Serial.println();

    Serial.print(
      "First live count: "
    );


    Serial.println(
      apiCount
    );


    Serial.print(
      "Using "
    );


    Serial.print(
      currentSlotCount
    );


    Serial.println(
      "-digit layout."
    );


    Serial.println(
      "Starting 2-second startup flip..."
    );


    return;
  }


  // ==========================================================
  // NORMAL LIVE RESULT
  // ==========================================================

  Serial.print(
    "Physical display = "
  );


  Serial.println(
    followerCount
  );


  Serial.print(
    "Previous API     = "
  );


  Serial.println(
    liveFollowerCount
  );


  Serial.print(
    "New API          = "
  );


  Serial.println(
    apiCount
  );


  if (
    apiCount !=
    liveFollowerCount
  ) {

    Serial.println(
      "*** FOLLOWER CHANGE DETECTED ***"
    );


    // IMPORTANT:
    //
    // Do NOT change followerCount here.
    //
    // Only update desired live value.
    //
    // updateLiveCounter() will animate toward it.
    liveFollowerCount =
      apiCount;
  }


  else {

    Serial.println(
      "Follower count unchanged."
    );
  }
}


// ============================================================
// RUN ONE API POLL
//
// Network request timing is measured.
//
// After the request:
//
// 1. animation clocks are compensated
// 2. a FRESH millis() is used
// 3. next API poll is scheduled
// ============================================================

void pollInstagramNow() {

  uint32_t networkStart =
    millis();


  uint32_t apiFollowers =
    0;


  bool success =
    fetchInstagramFollowers(
      apiFollowers
    );


  uint32_t networkEnd =
    millis();


  uint32_t networkDuration =
    networkEnd -
    networkStart;


  // ==========================================================
  // CRITICAL ANIMATION FIX
  // ==========================================================

  compensateForNetworkDelay(
    networkDuration
  );


  Serial.print(
    "API request duration: "
  );


  Serial.print(
    networkDuration
  );


  Serial.println(
    " ms"
  );


  // FRESH time AFTER HTTPS request
  uint32_t freshNow =
    millis();


  if (success) {

    processInstagramResult(
      apiFollowers,
      freshNow
    );


    nextApiPoll =
      freshNow +
      API_POLL_INTERVAL;
  }


  else {

    Serial.println(
      "API check failed. Keeping last valid follower count."
    );


    nextApiPoll =
      freshNow +
      API_RETRY_INTERVAL;
  }


  Serial.print(
    "Next API check in about "
  );


  Serial.print(
    success
      ? API_POLL_INTERVAL / 1000
      : API_RETRY_INTERVAL / 1000
  );


  Serial.println(
    " seconds."
  );


  Serial.println(
    "--------------------------------"
  );
}


