// ============================================================
// COUNTER PANEL GRADIENT
//
// Continuous gradient across entire counter.
// This makes wide 4-digit panels look much better.
// ============================================================

CRGB counterPanelColor(
  int x,
  int y,
  bool active
) {

  uint8_t horizontal =
    map(
      x,
      COUNTER_X,
      WIDTH - 1,
      0,
      255
    );


  // Top
  CRGB upper =
    blend(
      CRGB(55, 5, 115),
      CRGB(155, 5, 135),
      horizontal
    );


  // Center
  CRGB middle =
    blend(
      CRGB(170, 10, 155),
      CRGB(235, 15, 110),
      horizontal
    );


  // Bottom
  CRGB lower =
    blend(
      CRGB(220, 10, 140),
      CRGB(255, 70, 30),
      horizontal
    );


  CRGB color;


  if (y <= 3) {

    color =
      blend(
        upper,
        middle,
        y * 70
      );

  } else {

    color =
      blend(
        middle,
        lower,
        (y - 4) * 70
      );
  }


  if (active) {

    color.r =
      qadd8(
        color.r,
        18
      );


    color.b =
      qadd8(
        color.b,
        8
      );
  }


  return color;
}


// ============================================================
// DRAW ONE PANEL
// ============================================================

void drawPanel(
  uint8_t slot,
  uint8_t slots,
  bool active
) {

  int panelX =
    getPanelX(
      slot,
      slots
    );


  int panelWidth =
    getPanelWidth(
      slots
    );


  int gapWidth =
    getGapWidth(
      slots
    );


  // Panel body
  for (
    int y = 0;
    y < HEIGHT;
    y++
  ) {

    for (
      int xx = 0;
      xx < panelWidth;
      xx++
    ) {

      int globalX =
        panelX + xx;


      pixel(
        globalX,
        y,
        counterPanelColor(
          globalX,
          y,
          active
        )
      );
    }
  }


  // Mechanical center split
  for (
    int xx = 0;
    xx < panelWidth;
    xx++
  ) {

    int globalX =
      panelX + xx;


    CRGB hinge =
      counterPanelColor(
        globalX,
        3,
        false
      );


    hinge.nscale8_video(
      72
    );


    pixel(
      globalX,
      3,
      hinge
    );
  }


  // Black panel gap
  if (
    slot <
    slots - 1
  ) {

    int gapX =
      panelX +
      panelWidth;


    for (
      int gx = 0;
      gx < gapWidth;
      gx++
    ) {

      for (
        int y = 0;
        y < HEIGHT;
        y++
      ) {

        pixel(
          gapX + gx,
          y,
          CRGB::Black
        );
      }
    }
  }
}


// ============================================================
// DRAW DIGIT AT ARBITRARY Y POSITION
// ============================================================

void drawDigitAt(
  uint8_t number,
  int startX,
  int startY,
  CRGB color,
  uint8_t scaleX
) {

  if (number > 9) {

    // BLANK_DIGIT
    return;
  }


  for (
    int row = 0;
    row < DIGIT_HEIGHT;
    row++
  ) {

    uint8_t bits =
      font3x5[number][row];


    for (
      int col = 0;
      col < 3;
      col++
    ) {

      if (
        bits &
        (1 << (2 - col))
      ) {

        for (
          int sx = 0;
          sx < scaleX;
          sx++
        ) {

          int px =
            startX +
            col * scaleX +
            sx;


          int py =
            startY +
            row;


          if (
            px >= COUNTER_X &&
            px < WIDTH &&
            py >= 0 &&
            py < HEIGHT
          ) {

            pixel(
              px,
              py,
              color
            );
          }
        }
      }
    }
  }
}


