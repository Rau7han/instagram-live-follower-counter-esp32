// START WIFI
// ============================================================

void startWiFiConnection() {

  Serial.println();

  Serial.print(
    "Connecting to WiFi: "
  );


  Serial.println(
    WIFI_SSID
  );


  WiFi.begin(
    WIFI_SSID,
    WIFI_PASSWORD
  );


  lastReconnectAttempt =
    millis();
}


// ============================================================
// COMPLETE DISPLAY FRAME
// ============================================================

void renderDisplay(
  uint32_t now
) {

  FastLED.clear();


  // ==========================================================
  // INSTAGRAM LOGO
  // ==========================================================

  drawInstagramLogo(
    now
  );


  // ==========================================================
  // BLACK DIVIDER
  // ==========================================================

  for (
    int y = 0;
    y < HEIGHT;
    y++
  ) {

    pixel(
      8,
      y,
      CRGB::Black
    );
  }


  // ==========================================================
  // WAITING FOR FIRST API RESPONSE
  //
  // Instagram logo only.
  // ==========================================================

  if (
    !haveLiveCount
  ) {

    FastLED.show();


    return;
  }


  // ==========================================================
  // 2-SECOND STARTUP FULL FLIP
  // ==========================================================

  if (
    startupFlipping
  ) {

    for (
      uint8_t i = 0;
      i < currentSlotCount;
      i++
    ) {

      drawPanel(
        i,
        currentSlotCount,
        true
      );
    }


    drawFullFlipAnimation(
      currentSlotCount,
      now -
      startupFlipStart
    );


    FastLED.show();


    return;
  }


  // ==========================================================
  // LAYOUT TRANSITION
  // ==========================================================

  if (
    layoutFlipping
  ) {

    for (
      uint8_t i = 0;
      i < layoutTargetSlots;
      i++
    ) {

      drawPanel(
        i,
        layoutTargetSlots,
        true
      );
    }


    drawFullFlipAnimation(
      layoutTargetSlots,
      now -
      layoutFlipStart
    );


    FastLED.show();


    return;
  }


  // ==========================================================
  // NORMAL COLOR PANELS
  // ==========================================================

  for (
    uint8_t i = 0;
    i < currentSlotCount;
    i++
  ) {

    drawPanel(
      i,
      currentSlotCount,
      flipping &&
      i == activeDigit
    );
  }


  // ==========================================================
  // DIGITS
  // ==========================================================

  for (
    uint8_t i = 0;
    i < currentSlotCount;
    i++
  ) {

    // Active rolling digit
    if (
      flipping &&
      i == activeDigit
    ) {

      uint32_t elapsed =
        now -
        flipStart;


      if (
        elapsed >=
        FLIP_TIME
      ) {

        drawStaticDigit(
          i,
          currentSlotCount,
          targetDigits[i]
        );

      } else {

        uint8_t progress =
          (
            elapsed *
            255UL
          ) /
          FLIP_TIME;


        drawRollingDigit(
          i,
          currentSlotCount,
          currentDigits[i],
          targetDigits[i],
          progress,
          rollDirection
        );
      }
    }


    // Non-moving digit
    else {

      drawStaticDigit(
        i,
        currentSlotCount,
        currentDigits[i]
      );
    }
  }


  FastLED.show();
}


// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(
    115200
  );


  delay(300);


  Serial.println();

  Serial.println(
    "===================================="
  );

  Serial.println(
    " LIVE INSTAGRAM FOLLOWER COUNTER"
  );

  Serial.println(
    "===================================="
  );


  // ==========================================================
  // FASTLED
  // ==========================================================

  FastLED.addLeds<
    CHIPSET,
    DATA_PIN,
    COLOR_ORDER
  >(
    leds,
    NUM_LEDS
  );


  FastLED.setBrightness(
    BRIGHTNESS
  );


  FastLED.setMaxPowerInVoltsAndMilliamps(
    5,
    MAX_MILLIAMPS
  );


  FastLED.clear();


  FastLED.show();


  // ==========================================================
  // WIFI
  // ==========================================================

  WiFi.mode(
    WIFI_STA
  );


  WiFi.setAutoReconnect(
    true
  );


  // Helps responsiveness on permanently powered ESP32 displays
  WiFi.setSleep(
    false
  );


  startWiFiConnection();


  // First Instagram request happens immediately after WiFi
  // connects.
  firstApiCheck =
    true;


  nextApiPoll =
    0;


  previousWiFiConnected =
    false;


  renderDisplay(
    millis()
  );
}


// ============================================================
// LOOP
// ============================================================

void loop() {

  uint32_t now =
    millis();


  // ==========================================================
  // WIFI STATE
  // ==========================================================

  bool wifiConnected =
    (
      WiFi.status() ==
      WL_CONNECTED
    );


  // ==========================================================
  // WIFI JUST CONNECTED / RECONNECTED
  // ==========================================================

  if (
    wifiConnected &&
    !previousWiFiConnected
  ) {

    Serial.println();

    Serial.println(
      "WiFi connected!"
    );


    Serial.print(
      "ESP32 IP: "
    );


    Serial.println(
      WiFi.localIP()
    );


    // Force immediate Instagram refresh
    firstApiCheck =
      true;
  }


  previousWiFiConnected =
    wifiConnected;


  // ==========================================================
  // WIFI RECONNECT
  // ==========================================================

  if (
    !wifiConnected
  ) {

    if (
      now -
      lastReconnectAttempt >=
      WIFI_RETRY_INTERVAL
    ) {

      lastReconnectAttempt =
        now;


      Serial.println(
        "WiFi disconnected. Reconnecting..."
      );


      WiFi.disconnect();


      WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
      );
    }
  }


  // ==========================================================
  // LIVE INSTAGRAM POLLING
  //
  // IMPORTANT:
  //
  // NOT dependent on:
  //
  //   flipping
  //   startupFlipping
  //   layoutFlipping
  //
  // It continues checking Instagram regardless.
  // ==========================================================

  if (
    wifiConnected
  ) {

    if (
      firstApiCheck ||
      (
        (int32_t)(
          now -
          nextApiPoll
        ) >= 0
      )
    ) {

      firstApiCheck =
        false;


      Serial.println();

      Serial.println(
        "===================================="
      );

      Serial.println(
        " POLLING INSTAGRAM"
      );

      Serial.println(
        "===================================="
      );


      pollInstagramNow();


      // ======================================================
      // VERY IMPORTANT
      //
      // HTTP GET was blocking.
      //
      // Throw away old 'now' and get a FRESH time.
      // ======================================================

      now =
        millis();
    }
  }


  // ==========================================================
  // FINISH STARTUP FLIP
  // ==========================================================

  if (
    startupFlipping &&
    (
      now -
      startupFlipStart >=
      STARTUP_FLIP_TIME
    )
  ) {

    startupFlipping =
      false;


    // Use latest API value.
    //
    // If follower count changed while startup was spinning,
    // display the newest value.
    followerCount =
      liveFollowerCount;


    transitionTargetCount =
      followerCount;


    currentSlotCount =
      getSlotCount(
        followerCount
      );


    numberToDigits(
      followerCount,
      currentSlotCount,
      currentDigits
    );


    numberToDigits(
      followerCount,
      currentSlotCount,
      targetDigits
    );


    nextAnimationStep =
      now +
      CATCHUP_PAUSE;


    Serial.println();

    Serial.println(
      "Startup animation finished."
    );


    Serial.print(
      "Displaying LIVE followers: "
    );


    Serial.println(
      followerCount
    );
  }


  // ==========================================================
  // FINISH 2/4/6 LAYOUT TRANSITION
  // ==========================================================

  if (
    layoutFlipping &&
    (
      now -
      layoutFlipStart >=
      LAYOUT_FLIP_TIME
    )
  ) {

    finishLayoutFlip(
      now
    );
  }


  // ==========================================================
  // FINISH CURRENT MECHANICAL DIGIT
  // ==========================================================

  if (
    flipping &&
    (
      now -
      flipStart >=
      FLIP_TIME
    )
  ) {

    finishCurrentDigit(
      now
    );
  }


  // ==========================================================
  // MOVE DISPLAY TOWARD CURRENT LIVE INSTAGRAM COUNT
  // ==========================================================

  updateLiveCounter(
    now
  );


  // ==========================================================
  // DISPLAY RENDER
  // ==========================================================

  if (
    now -
    lastFrame >=
    FRAME_TIME
  ) {

    lastFrame =
      now;


    renderDisplay(
      now
    );
  }
}
