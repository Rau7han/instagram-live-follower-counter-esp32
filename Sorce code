// ============================================================
// SELECT 2 / 4 / 6 PANELS
//
// 0 - 99          = 2 panels
// 100 - 9999      = 4 panels
// 10000 - 999999  = 6 panels
//
// Therefore:
//
// 42     -> 42
// 2305   -> 2305
// 123456 -> 123456
//
// NO artificial leading zeroes.
// ============================================================

uint8_t getSlotCount(
  uint32_t number
) {

  if (number < 100) {

    return 2;
  }


  if (number < 10000) {

    return 4;
  }


  return 6;
}


// ============================================================
// PANEL WIDTH
//
// 2 digit:
//
// 10 + 3 gap + 10 = 23
//
// 4 digit:
//
// 5+1+5+1+5+1+5 = 23
//
// 6 digit:
//
// 3+1+3+1+3+1+3+1+3+1+3 = 23
// ============================================================

uint8_t getPanelWidth(
  uint8_t slots
) {

  if (slots == 2) {

    return 10;
  }


  if (slots == 4) {

    return 5;
  }


  return 3;
}


// ============================================================
// PANEL GAP WIDTH
// ============================================================

uint8_t getGapWidth(
  uint8_t slots
) {

  if (slots == 2) {

    return 3;
  }


  return 1;
}


// ============================================================
// DIGIT HORIZONTAL SCALE
//
// 2-digit mode gets thicker/wider numbers.
// ============================================================

uint8_t getDigitScaleX(
  uint8_t slots
) {

  if (slots == 2) {

    return 2;
  }


  return 1;
}


// ============================================================
// PANEL X POSITION
// ============================================================

int getPanelX(
  uint8_t slot,
  uint8_t slots
) {

  int panelWidth =
    getPanelWidth(slots);


  int gapWidth =
    getGapWidth(slots);


  return
    COUNTER_X +
    slot *
    (
      panelWidth +
      gapWidth
    );
}


// ============================================================
// DIGIT X POSITION
//
// Centers digit inside panel.
// ============================================================

int getDigitX(
  uint8_t slot,
  uint8_t slots
) {

  int panelX =
    getPanelX(
      slot,
      slots
    );


  int panelWidth =
    getPanelWidth(
      slots
    );


  int scaleX =
    getDigitScaleX(
      slots
    );


  int digitWidth =
    3 * scaleX;


  return
    panelX +
    (
      panelWidth -
      digitWidth
    ) / 2;
}


// ============================================================
// NUMBER -> DIGITS
//
// Example:
//
// 2305 + 4 panels:
//
// [2][3][0][5]
//
// Example:
//
// 305 + 4 panels:
//
// [blank][3][0][5]
//
// NOT:
//
// [0][3][0][5]
// ============================================================

void numberToDigits(
  uint32_t number,
  uint8_t slots,
  uint8_t output[]
) {

  for (
    int i = 0;
    i < MAX_DIGITS;
    i++
  ) {

    output[i] =
      BLANK_DIGIT;
  }


  if (number == 0) {

    output[slots - 1] =
      0;


    return;
  }


  int position =
    slots - 1;


  while (
    number > 0 &&
    position >= 0
  ) {

    output[position] =
      number % 10;


    number /= 10;


    position--;
  }
}


// ============================================================
// IMPROVED INSTAGRAM LOGO GRADIENT
//
// purple -> magenta -> pink -> orange
// ============================================================

CRGB instagramColor(
  uint8_t x,
  uint8_t y,
  uint32_t now
) {

  uint8_t position =
    x * 11 +
    y * 17;


  CRGB color;


  // Purple -> magenta
  if (position < 55) {

    color =
      blend(
        CRGB(75, 25, 190),
        CRGB(170, 20, 180),
        map(
          position,
          0,
          54,
          0,
          255
        )
      );
  }


  // Magenta -> pink
  else if (position < 108) {

    color =
      blend(
        CRGB(170, 20, 180),
        CRGB(235, 25, 120),
        map(
          position,
          55,
          107,
          0,
          255
        )
      );
  }


  // Pink -> orange
  else {

    int amount =
      map(
        position,
        108,
        190,
        0,
        255
      );


    amount =
      constrain(
        amount,
        0,
        255
      );


    color =
      blend(
        CRGB(235, 25, 120),
        CRGB(255, 135, 25),
        amount
      );
  }


  // Slight warm/yellow lower edge
  if (y >= 6) {

    uint8_t amount =
      (y - 5) * 28;


    color =
      blend(
        color,
        CRGB(255, 170, 45),
        amount
      );
  }


  // Keep logo gently alive
  uint8_t breathe =
    beatsin8(
      7,
      225,
      255
    );


  color.nscale8_video(
    breathe
  );


  return color;
}


