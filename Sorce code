// ============================================================
// YOUR CORRECT MATRIX MAPPING
//
// DO NOT CHANGE.
//
// Physical panel:
//
// 32 vertical columns
// 8 LEDs per column
// serpentine / zig-zag
// ============================================================

uint16_t XY(uint8_t x, uint8_t y) {

  if (x >= WIDTH || y >= HEIGHT) {
    return 0;
  }

  if ((x & 1) == 0) {

    // even column:
    // top -> bottom

    return
      (x * HEIGHT) + y;

  } else {

    // odd column:
    // bottom -> top

    return
      (x * HEIGHT) +
      (HEIGHT - 1 - y);
  }
}


// ============================================================
// SAFE PIXEL
// ============================================================

void pixel(
  int x,
  int y,
  CRGB color
) {

  if (
    x < 0 ||
    x >= WIDTH ||
    y < 0 ||
    y >= HEIGHT
  ) {

    return;
  }


  leds[XY(x, y)] =
    color;
}


